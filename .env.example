# Copy this file to `.env` and fill in the values.
# `.env` is loaded automatically by src/config.py (python-dotenv) and by
# docker-compose (api/worker services declare `env_file: .env`).

# --- Required ----------------------------------------------------------------
# OpenAI-compatible API key used by the LLM client (src/agents/llm.py).
OPENAI_API_KEY=

# Tavily web search API key (src/agents/nodes/web_searcher.py).
TAVILY_API_KEY=

# --- Optional overrides --------------------------------------------------
# Everything below has a working default (see src/config.py) and only needs
# to be set if you want to change it. Values marked "set by docker-compose.yml"
# are already provided for the containerized stack and don't need to be
# duplicated here.

# PostgreSQL DSN for session persistence. Unset = persistence disabled.
# Set by docker-compose.yml for the containerized stack.
# POSTGRES_URL=postgresql://aria:aria@localhost:5433/aria

# Redis / Celery broker & result backend. Set by docker-compose.yml.
# REDIS_URL=redis://localhost:6380
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# FastAPI host/port and the base URL the Streamlit UI uses to reach it.
# API_HOST=0.0.0.0
# API_PORT=5000
# API_BASE_URL=http://localhost:5000

# Native Ollama server base URL. On Windows/macOS Docker Desktop, set to
# http://host.docker.internal:11434 (already set by docker-compose.yml).
# OLLAMA_BASE_URL=http://localhost:11434

# UI polling behavior.
# RESPONSE_TIMEOUT_SECONDS=180
# RESPONSE_POLL_INTERVAL=0.5
# SOURCE_INGEST_TIMEOUT_SECONDS=120

# Conversation history windowing/summarization.
# HISTORY_SUMMARY_TRIGGER=20
# HISTORY_WINDOW_SIZE=10

# Code executor / upload storage directories.
# CODE_OUTPUTS_DIR=./data/code_outputs
# UPLOADS_DIR=./data/uploads

# RAG (personal source upload) settings.
# CHROMA_PERSIST_DIR=./data/chroma
# RAG_TOP_K=5
# RAG_MAX_CONTEXT_CHARS=8000
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=150
# MAX_UPLOAD_MB=15
